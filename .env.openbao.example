# ==============================================================================
# OpenBao / HashiCorp Vault Configuration Example with Varlock (varlock.dev)
# ==============================================================================
# This file demonstrates how to securely retrieve SolidFlow configuration and
# secrets dynamically from an OpenBao (or HashiCorp Vault) instance using Varlock.
#
# To use:
# 1. Start your OpenBao server (e.g. `bao server -dev` or cluster URL).
# 2. Authenticate using your preferred method:
#    - Local dev: `bao login` (stores token in ~/.bao-token which Varlock auto-detects)
#    - Explicit token: set VAULT_TOKEN below
#    - AppRole / CI: set VAULT_ROLE_ID and VAULT_SECRET_ID
# 3. Store secrets in your OpenBao KV v2 mount (e.g. `secret/solidflow`):
#    bao kv put secret/solidflow \
#      SURREALDB_PASS="your-strong-surrealdb-pass" \
#      AUTH_SECRET="your-32-char-random-auth-secret" \
#      OIDC_CLIENT_SECRET="your-oidc-client-secret"
# 4. Copy this file to `.env.local` or load with `bun run varlock:load`.
# ==============================================================================

# OpenBao Server Endpoint
VAULT_ADDR="http://127.0.0.1:8200"

# (Optional) Explicit Token - not needed if using `bao login` or AppRole
# VAULT_TOKEN="s.my-openbao-token"

# Database Configuration (retrieved dynamically from OpenBao)
SURREALDB_URL="wss://ux-ti-06g5t3b4ldol77m9fqh7a91jv8.azure-gwc.surreal.cloud/rpc"
SURREALDB_USER="solid"
SURREALDB_PASS=vaultSecret("secret/solidflow#SURREALDB_PASS")
SURREALDB_NS="solidflow"
SURREALDB_DB="main"

# Authentication & OIDC Secrets (retrieved from OpenBao)
AUTH_SECRET=vaultSecret("secret/solidflow#AUTH_SECRET")
OIDC_CLIENT_ID="solid-grpcfront"
OIDC_CLIENT_SECRET=vaultSecret("secret/solidflow#OIDC_CLIENT_SECRET")
OIDC_ISSUER="https://auth.401c6411-20e6-4053-8c2b-062d3c6ffcc0.k8s.civo.com/api/realms/master"
APP_ORIGIN="https://401c6411-20e6-4053-8c2b-062d3c6ffcc0.k8s.civo.com"
