# ------------------------------------------------------------------------------
# Varlock Environment Schema for SolidFlow
# https://varlock.dev
# ------------------------------------------------------------------------------

# 1. Register HashiCorp Vault / OpenBao Plugin
# The plugin automatically detects local OpenBao login (~/.bao-token) or Vault login (~/.vault-token),
# or connects via explicit VAULT_TOKEN / AppRole when deployed.
# @plugin(@varlock/hashicorp-vault-plugin)
# @initHcpVault(url=$VAULT_ADDR)
# ---

# OpenBao / HashiCorp Vault Server
# @public @optional
VAULT_ADDR="http://127.0.0.1:8200"

# Optional token (leave empty if using `bao login` / `vault login` CLI token or AppRole)
# @sensitive @internal @optional
VAULT_TOKEN=

# Server Runtime Settings
# @public
PORT=3000
# @public
NODE_ENV=development

# SurrealDB Configuration
# Values can be provided in .env or resolved from OpenBao/Vault:
# e.g. SURREALDB_PASS=vaultSecret("secret/solidflow#SURREALDB_PASS")
# @public
SURREALDB_URL="wss://ux-ti-06g5t3b4ldol77m9fqh7a91jv8.azure-gwc.surreal.cloud/rpc"
# @public
SURREALDB_USER="solid"
# @sensitive
SURREALDB_PASS="sol1d"
# @public
SURREALDB_NS="solidflow"
# @public
SURREALDB_DB="main"
# @public @optional
SURREALDB_CONNECT_TIMEOUT_MS=8000

# Authentication & OIDC Credentials
# @sensitive
AUTH_SECRET="JhWziCfG2qCmYPCT"
# @public
OIDC_CLIENT_ID="solid-grpcfront"
# @sensitive
OIDC_CLIENT_SECRET="JhWziCfG2qCmYPCT"
# @public
OIDC_ISSUER="https://auth.401c6411-20e6-4053-8c2b-062d3c6ffcc0.k8s.civo.com/api/realms/master"
# @public @optional
OIDC_REDIRECT_URI=
# @public @optional
APP_ORIGIN="https://401c6411-20e6-4053-8c2b-062d3c6ffcc0.k8s.civo.com"
# @public @optional
AUTH_CLIENT_NAME="solid-grpcfront"
# @public @optional
AUTH_TRUST_HOST="true"

# Monitoring & Error Reporting
# @public @optional
SENTRY_DSN=
